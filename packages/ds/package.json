    "react-i18next": "^17.1.13",
    "react-resizable-panels": "^4.19.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
