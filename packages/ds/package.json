{
  "name": "@fma-ds/ds",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit && pnpm generate:registry && pnpm registry:build",
    "dev": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "generate:registry": "tsx scripts/gen-registry-json.ts",
    "registry:build": "shadcn build --cwd . --output ../../apps/web/public/r && pnpm registry:prune",
    "registry:prune": "tsx scripts/prune-registry-output.ts",
    "add:shadcn": "tsx scripts/add-shadcn.ts",
    "add:registry": "tsx scripts/add-from-registry.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
